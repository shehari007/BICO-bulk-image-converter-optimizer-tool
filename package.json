{
  "name": "bico-bulk-image-converter-optimizer-tool",
  "productName": "BICO",
  "version": "3.0.0",
  "description": "BICO is a professional grade bulk image converter and optimizer with GPU accelerated processing, a multi threaded sharp pipeline and a modern desktop interface.",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Muhammad Sheharyar Butt",
    "email": "shehariyar@gmail.com",
    "url": "https://github.com/shehari007"
  },
  "homepage": "https://github.com/shehari007/BICO-bulk-image-converter-optimizer-tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/shehari007/BICO-bulk-image-converter-optimizer-tool.git"
  },
  "bugs": {
    "url": "https://github.com/shehari007/BICO-bulk-image-converter-optimizer-tool/issues"
  },
  "keywords": [
    "image-converter",
    "image-optimizer",
    "bulk-converter",
    "webp",
    "avif",
    "jpeg-xl",
    "jpeg-2000",
    "sharp",
    "electron",
    "webgpu",
    "gpu-acceleration"
  ],
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@imagemagick/magick-wasm": "^0.0.42",
    "@jsquash/jxl": "^1.3.0",
    "archiver": "^7.0.1",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@eslint/js": "^9.39.5",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@webgpu/types": "^0.1.71",
    "antd": "^6.6.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
